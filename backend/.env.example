# ================= MarketPilot backend configuration =================
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.

# ---- Application ----
ENVIRONMENT=development
# Market data source: "mock" (deterministic demo, no credentials) or "kotak" (live, read-only)
MARKET_DATA_PROVIDER=mock

# ---- Database ----
MONGO_URL=mongodb://localhost:27017
DB_NAME=marketpilot

# ---- Authentication ----
# Generate: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
DEMO_EMAIL=demo@marketpilot.in
DEMO_PASSWORD=CHANGE_ME

# ---- Email (password reset; optional locally) ----
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=MarketPilot

# ---- Kotak Neo (READ-ONLY; NO order execution) ----
# Valid KOTAK_ENVIRONMENT values: prod | uat
KOTAK_ENVIRONMENT=prod
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE=
KOTAK_UCC=
KOTAK_MPIN=
KOTAK_TOTP_SECRET=
# Not required by the current Kotak auth flow (kept for forward-compat):
KOTAK_API_KEY=
KOTAK_API_SECRET=
KOTAK_CONSUMER_SECRET=

# ---- Telegram notifications (bot token is SERVER-SIDE ONLY) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- CORS ----
# Comma-separated extra origins (the frontend URL + http://localhost:3000 are always allowed)
CORS_ORIGINS=http://localhost:3000
